#include <iostream>
using namespace std;

int factorial(int r) {
    int fact = 1;
    for (int i = 1; i <= r; i++) fact *= i;
    return fact;
}

bool isStrong(int n) {
    int temp = n, sum = 0;
    while (temp > 0) {
        int digit = temp % 10;
        sum += factorial(digit);
        temp /= 10;
    }
    return sum == n;
}
int main() {
    int num;
    cout << "Enter a number: ";
    cin >> num;

    if (isStrong(num)) {
        cout << num << " is a strong number." << endl;
    } else {
        cout << num << " is not a strong number." << endl;
    }

    return 0;
}